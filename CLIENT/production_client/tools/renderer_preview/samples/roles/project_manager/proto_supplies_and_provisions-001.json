{
  "version": "1.0",
  "title": "Статус обеспечения КИ",
  "widgets": [
    {
      "type": "QLabel",
      "id": "header_title",
      "text": "Статус обеспечения КИ (прототипы)",
      "properties": {
        "font.pixelSize": 22,
        "font.bold": true,
        "color": "#ffffff"
      }
    },
    {
      "type": "QGroupBox",
      "id": "group_filters",
      "title": "Фильтры",
      "widgets": [
        {
          "type": "QLabel",
          "id": "lbl_project",
          "text": "Проект:"
        },
        {
          "type": "QComboBox",
          "id": "project_combo",
          "items": [
            {"label": "Проект А", "value": "proj_a"},
            {"label": "Проект Б", "value": "proj_b"},
            {"label": "Проект В", "value": "proj_c"}
          ]
        },
        {
          "type": "QLabel",
          "id": "lbl_stage",
          "text": "Этап:"
        },
        {
          "type": "QComboBox",
          "id": "stage_combo",
          "items": [
            {"label": "Все этапы", "value": "all"},
            {"label": "Разработка", "value": "dev"},
            {"label": "Испытания", "value": "test"},
            {"label": "Внедрение", "value": "deploy"}
          ]
        },
        {
          "type": "QLabel",
          "id": "lbl_date_from",
          "text": "С:"
        },
        {
          "type": "QDateEdit",
          "id": "date_from",
          "date": "2026-01-01"
        },
        {
          "type": "QLabel",
          "id": "lbl_date_to",
          "text": "По:"
        },
        {
          "type": "QDateEdit",
          "id": "date_to",
          "date": "2026-12-31"
        },
        {
          "type": "QPushButton",
          "id": "btn_refresh",
          "text": "Обновить"
        }
      ]
    },
    {
      "type": "QGroupBox",
      "id": "group_charts",
      "title": "Аналитика",
      "widgets": [
        {
          "type": "ChartPie",
          "id": "pie_status",
          "title": "Статус КИ по категориям",
          "height": 350,
          "data": {
            "source": "inline",
            "Marked_values": [
              {"label": "Разработана", "value": 45},
              {"label": "На испытаниях", "value": 30},
              {"label": "Внедрена", "value": 15},
              {"label": "Отменена", "value": 10}
            ]
          }
        },
        {
          "type": "ChartBar",
          "id": "bar_progress",
          "title": "Прогресс по этапам",
          "height": 350,
          "data": {
            "source": "inline",
            "Marked_values": [
              {"label": "Этап 1", "value": 100},
              {"label": "Этап 2", "value": 80},
              {"label": "Этап 3", "value": 60},
              {"label": "Этап 4", "value": 40},
              {"label": "Этап 5", "value": 20}
            ]
          }
        },
        {
          "type": "ChartLine",
          "id": "line_dynamics",
          "title": "Динамика поставок",
          "height": 350,
          "data": {
            "source": "inline",
            "Marked_values": [
              {"label": "Янв", "value": 10},
              {"label": "Фев", "value": 25},
              {"label": "Мар", "value": 40},
              {"label": "Апр", "value": 30},
              {"label": "Май", "value": 55},
              {"label": "Июн", "value": 70},
              {"label": "Июл", "value": 65},
              {"label": "Авг", "value": 85}
            ]
          }
        },
        {
          "type": "ChartBarCompare",
          "id": "bar_compare",
          "title": "Сравнение плана и факта",
          "height": 350,
          "data": {
            "source": "inline",
            "Marked_values": [
              {"label": "Кв.1", "value": 50},
              {"label": "Кв.2", "value": 70},
              {"label": "Кв.3", "value": 60},
              {"label": "Кв.4", "value": 80}
            ]
          },
          "data2": {
            "source": "inline",
            "Marked_values": [
              {"label": "Кв.1", "value": 40},
              {"label": "Кв.2", "value": 65},
              {"label": "Кв.3", "value": 55},
              {"label": "Кв.4", "value": 75}
            ]
          }
        }
      ]
    },
    {
      "type": "QGroupBox",
      "id": "group_table",
      "title": "Перечень КИ",
      "widgets": [
        {
          "type": "QTableWidget",
          "id": "ki_table",
          "columns": [
            {"id": "id", "label": "ID", "width": 50},
            {"id": "name", "label": "Наименование", "width": 250},
            {"id": "type", "label": "Тип", "width": 120},
            {"id": "status", "label": "Статус", "width": 150},
            {"id": "deadline", "label": "Срок", "width": 120}
          ]
        }
      ]
    },
    {
      "type": "QLabel",
      "id": "action_label",
      "text": "Действия:"
    },
    {
      "type": "QPushButton",
      "id": "btn_export",
      "text": "📊 Экспорт"
    },
    {
      "type": "QPushButton",
      "id": "btn_print",
      "text": "🖨 Печать"
    },
    {
      "type": "QPushButton",
      "id": "btn_send",
      "text": "📧 Отправить"
    }
  ]
}
