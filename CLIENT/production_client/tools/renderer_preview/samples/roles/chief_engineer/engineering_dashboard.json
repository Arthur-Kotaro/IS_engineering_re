{
  "version": "1.0",
  "title": "Инженерный дашборд",
  "widgets": [
    {
      "type": "QLabel",
      "id": "header",
      "text": "Инженерный дашборд",
      "properties": {
        "font.pixelSize": 22,
        "font.bold": true,
        "color": "#ffffff"
      }
    },
    {
      "type": "QGroupBox",
      "id": "group_tech",
      "title": "Технические показатели",
      "widgets": [
        {
          "type": "ChartPie",
          "id": "pie_components",
          "title": "Состав компонентов",
          "height": 350,
          "data": {
            "source": "inline",
            "Marked_values": [
              {"label": "Механика", "value": 35},
              {"label": "Электроника", "value": 30},
              {"label": "Софт", "value": 20},
              {"label": "Документация", "value": 15}
            ]
          }
        },
        {
          "type": "ChartBar",
          "id": "bar_tests",
          "title": "Результаты испытаний",
          "height": 350,
          "data": {
            "source": "inline",
            "Marked_values": [
              {"label": "Успешно", "value": 60},
              {"label": "С ошибками", "value": 25},
              {"label": "Не пройдено", "value": 15}
            ]
          }
        }
      ]
    },
    {
      "type": "QGroupBox",
      "id": "group_docs",
      "title": "Документация",
      "widgets": [
        {
          "type": "QTableWidget",
          "id": "docs_table",
          "columns": [
            {"id": "id", "label": "ID", "width": 50},
            {"id": "name", "label": "Документ", "width": 300},
            {"id": "version", "label": "Версия", "width": 80},
            {"id": "status", "label": "Статус", "width": 120}
          ]
        }
      ]
    }
  ]
}
