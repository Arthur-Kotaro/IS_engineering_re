{
  "version": "1.0",
  "title": "Дашборд",
  "widgets": [
    {
      "type": "QLabel",
      "id": "welcome_label",
      "text": "Добро пожаловать в систему!",
      "properties": {
        "font.pixelSize": 24,
        "font.bold": true,
        "color": "#ffffff"
      }
    },
    {
      "type": "QGroupBox",
      "id": "filters_group",
      "title": "Фильтры",
      "widgets": [
        {
          "type": "QComboBox",
          "id": "period_filter",
          "items": [
            {"label": "Сегодня", "value": "today"},
            {"label": "Неделя", "value": "week"},
            {"label": "Месяц", "value": "month"}
          ],
          "currentIndex": 1
        },
        {
          "type": "QPushButton",
          "id": "apply_btn",
          "text": "Применить"
        }
      ]
    },
    {
      "type": "QHBoxLayout",
      "id": "charts_row",
      "widgets": [
        {
          "type": "ChartPie",
          "id": "status_pie",
          "title": "Статусы заказов"
        },
        {
          "type": "ChartBar",
          "id": "amounts_bar",
          "title": "Суммы по месяцам"
        }
      ]
    }
  ]
}
