      "text": "Вариант 1"
    },
    {
      "type": "QRadioButton",
      "id": "radio_opt2",
      "text": "Вариант 2"
    },
    {
      "type": "QRadioButton",
      "id": "radio_opt3",
      "text": "Вариант 3"
