{
  "version": "1.0",
  "title": "Тест кнопок",
  "widgets": [
    {
      "type": "QLabel",
      "id": "label_buttons",
      "text": "Различные кнопки",
      "properties": {
        "font.pixelSize": 18,
        "font.bold": true,
        "color": "#ffffff"
      }
    },
    {
      "type": "QPushButton",
      "id": "btn_primary",
      "text": "Основная кнопка"
    },
    {
      "type": "QPushButton",
      "id": "btn_secondary",
      "text": "Вторичная кнопка"
    },
