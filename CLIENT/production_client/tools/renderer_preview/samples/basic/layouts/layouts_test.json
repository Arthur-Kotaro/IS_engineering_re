{
  "version": "1.0",
  "title": "Тест макетов",
  "widgets": [
    {
      "type": "QLabel",
      "id": "label_layouts",
      "text": "Сложные макеты",
      "properties": {
        "font.pixelSize": 18,
        "font.bold": true,
        "color": "#ffffff"
      }
    },
    {
      "type": "QGroupBox",
      "id": "group_filters",
      "title": "Фильтры",
      "widgets": [
        {
          "type": "QLabel",
          "id": "lbl_period",
          "text": "Период:"
        },
        {
          "type": "QComboBox",
          "id": "period_combo",
          "items": [
            {"label": "Сегодня", "value": "today"},
            {"label": "Неделя", "value": "week"},
            {"label": "Месяц", "value": "month"}
          ]
        },
        {
          "type": "QPushButton",
          "id": "btn_apply",
          "text": "Применить"
        },
        {
          "type": "QLabel",
          "id": "lbl_search",
          "text": "Поиск:"
        },
        {
          "type": "QLineEdit",
          "id": "search_input",
          "placeholder": "Введите запрос..."
        }
      ]
    },
    {
      "type": "QGroupBox",
      "id": "group_stats",
      "title": "Статистика",
      "widgets": [
        {
          "type": "ChartPie",
          "id": "pie_stats",
          "title": "Доля",
          "height": 350,
          "data": {
            "source": "inline",
            "Marked_values": [
              {"label": "Категория А", "value": 40},
              {"label": "Категория Б", "value": 30},
              {"label": "Категория В", "value": 20},
              {"label": "Категория Г", "value": 10}
            ]
          }
        },
        {
          "type": "ChartBar",
          "id": "bar_stats",
          "title": "Количество",
          "height": 350,
          "data": {
            "source": "inline",
            "Marked_values": [
              {"label": "Значение 1", "value": 50},
              {"label": "Значение 2", "value": 80},
              {"label": "Значение 3", "value": 30},
              {"label": "Значение 4", "value": 90},
              {"label": "Значение 5", "value": 60}
            ]
          }
        }
      ]
    }
  ]
}
